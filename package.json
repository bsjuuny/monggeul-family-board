{
  "name": "monggeul-family-board",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "몽글 패밀리보드 (React PWA + Python/SQLite 태블릿 서버, 동일 Wi-Fi 전용)",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc --noEmit -p tsconfig.json && vite build && npm run build:analyzer",
    "build:analyzer": "vite build --config vite.analyzer.config.ts",
    "e2e": "npm run build && python tablet_server/tools/run_e2e.py",
    "verify": "npm run typecheck && npm test && npm run test:server && npm run build",
    "test:server": "python -m unittest discover -s tablet_server/tests -v",
    "start": "python tablet_server/app.py --host 0.0.0.0 --port 8787"
  },
  "dependencies": {
    "@fontsource/jua": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@tanstack/react-query": "^5.108.0",
    "hls.js": "^1.7.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
